# TEMPLATE ONLY — this file is committed to the repository.
# Never put real keys here. Copy it to .env.local and fill that in instead.

# Settings → API → Project URL. Looks like https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Settings → API → anon / public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Used solely by src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Direct database connection, used only by the Supabase CLI to apply
# migrations and generate types. Never read by the running app.
# Any @ : / ? # [ ] in the password must be percent-encoded (@ becomes %40).
SUPABASE_DB_URL=
